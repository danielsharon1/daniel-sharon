# PlantFinder API configuration. Copy to .env and adjust. Nothing here is required for a local demo.

# Port the API (and the built web app) listens on.
PORT=8787
HOST=127.0.0.1

# Data mode:
#   live    - query real sources (requires outbound network access to the source hosts)
#   fixture - use recorded source snapshots shipped in the repo; every result is labeled DEMO
PF_DATA_MODE=live

# Deployment policy for sources (see docs/source-audit.md):
#   personal - personal/private pilot; sources whose terms restrict commercial reuse are enabled
#              with a visible notice. Do NOT expose a personal deployment publicly.
#   public   - only sources with recorded written permission (status "partner") are enabled.
PF_SOURCE_POLICY=personal

# Comma-separated origins allowed to call the API from a browser (the web app is same-origin and needs nothing).
# Chrome extension origins look like chrome-extension://<extension-id>.
PF_ALLOWED_ORIGINS=chrome-extension://*

# Optional: Pl@ntNet API key for photo identification (https://my.plantnet.org). Kept server-side only.
# PLANTNET_API_KEY=

# Optional: directory for cached source snapshots (defaults to services/api/.data)
# PF_DATA_DIR=
